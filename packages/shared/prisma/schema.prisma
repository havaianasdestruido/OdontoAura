generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  EMPLOYEE
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctorProfile DoctorProfile?
  appointments   Appointment[] @relation("PatientAppointments")
  medicalRecords MedicalRecord[] @relation("PatientRecords")
  healthPlans    PatientHealthPlan[]

  @@map("users")
}

model DoctorProfile {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @unique @map("user_id") @db.Uuid
  licenseNumber String          @unique @map("license_number")
  bio           String?
  specialtyId   String          @map("specialty_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty         Specialty           @relation(fields: [specialtyId], references: [id])
  availabilitySlots AvailabilitySlot[]
  appointments      Appointment[]       @relation("DoctorAppointments")
  medicalRecords    MedicalRecord[]     @relation("DoctorRecords")

  @@index([userId])
  @@index([specialtyId])
  @@map("doctor_profiles")
}

model Specialty {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  doctorProfiles DoctorProfile[]
  appointments   Appointment[]

  @@map("specialties")
}

model AvailabilitySlot {
  id        String  @id @default(uuid()) @db.Uuid
  doctorId  String  @map("doctor_id") @db.Uuid
  dayOfWeek Int     @map("day_of_week")
  startTime String  @map("start_time")
  endTime   String  @map("end_time")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("availability_slots")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  specialtyId     String            @map("specialty_id") @db.Uuid
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(30) @map("duration_minutes")
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient       User           @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor        DoctorProfile  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  specialty     Specialty      @relation(fields: [specialtyId], references: [id])
  medicalRecord MedicalRecord?

  @@index([patientId])
  @@index([doctorId])
  @@index([specialtyId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model MedicalRecord {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  doctorId      String   @map("doctor_id") @db.Uuid
  anamnesis     String?
  diagnosis     String?
  prescription  String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User         @relation("PatientRecords", fields: [patientId], references: [id])
  doctor      DoctorProfile @relation("DoctorRecords", fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("medical_records")
}

model HealthPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  provider           String
  coveragePercentage Float    @default(0) @map("coverage_percentage")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  patientHealthPlans PatientHealthPlan[]

  @@map("health_plans")
}

model PatientHealthPlan {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  healthPlanId String   @map("health_plan_id") @db.Uuid
  cardNumber   String   @map("card_number")
  expiryDate   DateTime @map("expiry_date")

  patient    User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthPlan HealthPlan  @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@unique([patientId, healthPlanId])
  @@index([patientId])
  @@index([healthPlanId])
  @@map("patient_health_plans")
}

model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("clinics")
}
