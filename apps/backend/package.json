{
  "name": "@odontoaura/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "vercel-build": "prisma generate && nest build && node scripts/bundle.mjs",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloud": "vitest run --config vitest.cloud.config.mts",
    "test:cov": "vitest run --coverage"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "esbuild": "0.24.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "12.0.1",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "20.19.43",
    "@types/passport-jwt": "4.0.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "8.57.1",
    "prisma": "5.22.0",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
